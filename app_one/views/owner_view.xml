<odoo>
  <record id="owner_view_tree" model="ir.ui.view">
    <field name="name">owner_tree</field>
    <field name="model">owner</field>
    <field name="arch" type="xml">
      <tree multi_edit="1" create="1" edit="1" delete="1">
            <field name="name" />
            <field name="phone" />
            <field name="address" />
      </tree>
    </field>
  </record>

<record id="owner_view_search" model="ir.ui.view">
    <field name="name">owner_search</field>
    <field name="model">owner</field>  <!-- تأكد أن الموديل صحيح -->
    <field name="arch" type="xml">
        <search>
            <!-- الحقول المستخدمة في البحث -->
            <field name="name"/>  <field name="name" />
            <field name="phone" />
            <field name="address" />

            <!-- الفلاتر (Filters) -->

        </search>
    </field>
</record>


  <record id="owner_view_form" model="ir.ui.view">
    <field name="name">owner form</field>
    <field name="model">owner</field>
    <field name="arch" type="xml">
      <form create="1" edit="1" delete="1">
        <sheet>
                <div class="oe_title">
                      <label for="name"/>
                     <h1> <field name="name" /></h1>
                </div>
          <group>
            <group string="General Info">
 <field name="property_ids" widget="many2many_tags" />
            <field name="address" />
            </group>
            <group string="Additional Info">
            <field name="address" />
            <field name="phone" />

            </group>
          </group>
          <group>

          </group>
        </sheet>

      </form>
    </field>
  </record>


  <record id="owner_view_kanban" model="ir.ui.view">
    <field name="name">owner view kanban</field>
    <field name="model">owner</field>
    <field name="type">kanban</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_mobile">
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_global_click">
              <div class="oe_kanban_card">
             <field name="name" />

              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="owner_action_ashraf" model="ir.actions.act_window">
    <field name="name">Owner ACTION</field>
    <field name="res_model">owner</field>
    <field name="view_mode">tree,form,search,kanban</field>
  </record>

  <menuitem id="owner_menu_item" name="Owner action" parent="deed_root_menu" action="owner_action_ashraf" />
</odoo>