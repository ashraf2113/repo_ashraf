<odoo>
  <record id="property_history_view_tree" model="ir.ui.view">
    <field name="name">property_history_tree</field>
    <field name="model">property.history</field>
    <field name="arch" type="xml">
      <tree create="0" edit="0" delete="0">
            <field name="user_id" />
            <field name="property_id" />
        <field name="old_state" />
            <field name="new_state" />
      </tree>
    </field>
  </record>


  <record id="property_history_view_form" model="ir.ui.view">
    <field name="name">property history form</field>
    <field name="model">property.history</field>
    <field name="arch" type="xml">
      <form create="0" edit="0" delete="0">
        <sheet>
          <group>
          <group>
            <field name="user_id" />
            <field name="property_id" />


          </group>

               <group>

        <field name="old_state" />
            <field name="new_state" />
        <field name="reason"/>
          </group>
        </group>

          <notebook>
                    <page string="Bedrooms">
                           <field name="line_ids">
                               <tree editable="top">
                                   <field name="area"/>
                                   <field name="description"/>
                               </tree>
                           </field>

                    </page>
            </notebook>

        </sheet>

      </form>
    </field>
  </record>


  <record id="property_history_view_kanban" model="ir.ui.view">
    <field name="name">property history view kanban</field>
    <field name="model">property.history</field>
    <field name="type">kanban</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_mobile">
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_global_click">

              <div class="oe_kanban_card">
                  <field name="user_id" />
            <field name="property_id" />
        <field name="old_state" />
            <field name="new_state" />

              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="property_history_action" model="ir.actions.act_window">
    <field name="name">property history action</field>
    <field name="res_model">property.history</field>
    <field name="view_mode">tree,form,search,kanban</field>
  </record>

  <menuitem id="property_history_menu_item"  name="property history" parent="deed_root_menu" action="property_history_action" />
</odoo>