<odoo>
  <record id="tag_view_tree" model="ir.ui.view">
    <field name="name">tag_tree</field>
    <field name="model">tag</field>
    <field name="arch" type="xml">
      <tree multi_edit="1" create="1" edit="1" delete="1">
        <field name="name" />
      </tree>
    </field>
  </record>


  <record id="tag_view_form" model="ir.ui.view">
    <field name="name">tag form</field>
    <field name="model">tag</field>
    <field name="arch" type="xml">
      <form create="1" edit="1" delete="1">
        <sheet>
          <group>
            <field name="name" />


          </group>
        </sheet>

      </form>
    </field>
  </record>


  <record id="tag_view_kanban" model="ir.ui.view">
    <field name="name">tag view kanban</field>
    <field name="model">tag</field>
    <field name="type">kanban</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_mobile">
        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_global_click">
              <div class="oe_kanban_card">
                <field name="name" />

              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="tag_action" model="ir.actions.act_window">
    <field name="name">Tag ACTION</field>
    <field name="res_model">tag</field>
    <field name="view_mode">tree,form,search,kanban</field>
  </record>

  <menuitem id="tag_menu_item" name="Tag" parent="deed_root_menu" action="tag_action" />
</odoo>