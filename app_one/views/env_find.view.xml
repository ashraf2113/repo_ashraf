<odoo>


    <record id="tree_env_find_views" model="ir.ui.view">
        <field name="name">env find</field>
        <field name="model">env.find</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="result"/>

            </tree>
        </field>
    </record>

    <record id="form_env_find_views" model="ir.ui.view">
        <field name="name">env find</field>
        <field name="model">env.find</field>
        <field name="arch" type="xml">
            <form>


                <sheet>
                <group>
                    <div>
                <button name="action_execute" string="execute" class="fa fa-check oe_highlight" type="object"/>
                </div>
                </group>
                <div>
                 <button name="action_clear" string="clear" class="fa fa-refresh oe_highlight" type="object"/>
                    </div>
                    <group>
             <field name="code" widget="ace" options="{'mode':'python'}"/>
             <field name="result" readonly="1"/>
                    </group>

                </sheet>

            </form>
        </field>
    </record>



    <record id="action_env_find_ashrafco" model="ir.actions.act_window">
        <field name="name">env find</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">env.find</field>
        <field name="view_mode">tree,form</field>
        <field name="target">inline</field>
    </record>

    <menuitem id="menu_env_find_ash"
              name="env find"
              parent="deed_root_menu"
              action="action_env_find_ashrafco"
              sequence="61" />
</odoo>
