<odoo>
        <record id="report_screen_flower_water_ashraf" model="ir.actions.report">
            <field name="name">report screen flower water</field>
            <field name="model">flower.water</field>
<!--               <field name="model">paper</field>-->
            <field name="report_type">qweb-pdf</field>
<!--            <field name="binding_model_id" ref="model_paper"/>-->
            <field name="binding_type">report</field>
            <field name="report_name">flower_watering.report_screen_flower_water_ashraf_template</field>
        </record>

            <template id="report_screen_flower_water_ashraf_template">
            <t t-call="web.html_container">
            <t t-call="web.basic_layout">


<div class="m-0 p-0 small table-sm">
                    <style>
                        .border-box {
                        <!--position: relative;-->
                        width: auto;
                        height: auto;
                        border: 1px solid black; /* لون البوردر اسود */
                        text-align: center;
                        <!--font-size: 21px;-->
                        <!--        font-weight: bold;-->
                        <!--color: blue; /* لون النص أسود */-->
                        }
                    </style>


<table class="m-0 p-0 small table-sm table table-borderless">
    <tr>
        <td class="text-center" width="70%">
            <img style="height:auto;width:auto;max-width:100%;"
                 t-att-src="'/flower_watering/static/src/img/flower_watering1.png'"/>
        </td>
    </tr>
</table>
<br/><br/><br/><br/><br/>
<h3 class="text-lift">Plant Watering</h3>
<table class="m-0 p-0 small table-sm table table-bordered">
<tr>
    <td>Serial No.</td>
    <td>Name Plant</td>
    <td>Watering Date</td>
    <td>Next Watering Date</td>
    <td>Frequency/days</td>
    <td>Watered By</td>
    <td>Note</td>
</tr>
<t t-foreach="docs" t-as="doc">
    <tr>
        <td>
            <t t-if="doc.lot_id and doc.lot_id.id">
                <span t-field="doc.lot_id.name"/>
            </t>

        </td>
        <td>
            <span t-field="doc.name_plant"/>
        </td>
        <td>
            <span t-field="doc.watering_date"/>
        </td>
        <td>
            <span t-field="doc.next_watering_date"/>
        </td>
        <td>
            <span t-field="doc.watering_frequency"/>
        </td>
        <td>
            <span t-field="doc.user_id.name"/>
        </td>
        <td>
            <span t-field="doc.note"/>
        </td>
    </tr>
</t>
</table>

        </div>
        </t>
        </t>
        <!-- </t> -->

        </template>

        </odoo>
