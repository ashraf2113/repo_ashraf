<odoo>

    <!-- 🛠️ مهمة: ربط المدينة تلقائيًا للمخازن كل ساعة -->
    <record id="ir_cron_action_fix_partner_city" model="ir.cron">
        <field name="name">Fix Partner City</field>
        <field name="model_id" ref="model_stock_warehouse"/>
        <field name="state">code</field>
        <field name="code">model.action_fix_partner_city()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

    <!-- 🌦️ مهمة: جلب وتسجيل بيانات الطقس وربطها بالمخازن كل ساعة -->
    <record id="ir_cron_fetch_and_process_weather" model="ir.cron">
        <field name="name">Fetch and Process Weather</field>
        <field name="model_id" ref="model_stock_warehouse"/>
        <field name="state">code</field>
        <field name="code">model.fetch_and_process_weather()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

</odoo>
