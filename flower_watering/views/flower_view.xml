<odoo>

    <record id="flower_view_tree" model="ir.ui.view">
        <field name="name">Watering Tree</field>
        <field name="model">flower.water</field>
        <field name="arch" type="xml">
            <tree multi_edit="1" create="1" edit="1" delete="1">
               <button name="action_fetch_weather" type="object" string="تحديث الطقس" class="oe_highlight"/>

                <field name="lot_id"/>
                <field name="name_plant"/>
                <field name="watering_date"/>
                <field name="next_watering_date"/>
                <field name="watering_frequency"/>
                <field name="user_id"/>
                <field name="note"/>
                 <field name="warehouse_id"/>
                  <field name="weather_datetime"/>
                  <field name="temperature"/>
                  <field name="humidity"/>
                  <field name="pressure"/>
                  <field name="rain_mm"/>

            </tree>
        </field>
    </record>
    <!-- أكشن قائمة flower.water -->
    <record id="action_flower_water" model="ir.actions.act_window">
        <field name="name">Watering Logs</field>
        <field name="res_model">flower.water</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[]</field>
    </record>
    <menuitem id="paper_menu_item" name="Plant Watering" parent="menu_plant_watering_root"
              action="action_flower_water"/>

</odoo>
