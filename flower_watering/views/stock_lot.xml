<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- تعديل فورم stock.lot -->
    <record id="view_production_lot_form_inherit" model="ir.ui.view">
        <field name="name">stock.production.lot.form</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='product_id']" position="after">
                <field name="name_plant"/>
            </xpath>

            <xpath expr="//form/sheet/notebook" position="inside">
                <!-- تبويب جديد لسجلات السقاية -->
                <page string="Watering Records">

                    <xpath expr="//tree" position="after">
                        <button name="action_bulk_water"
                                type="object"
                                string="Bulk Water"
                                class="btn-primary"
                                multi="True"/>
                    </xpath>

                    <button name="action_create_water_record"
                            type="object"
                            string="Water Now"
                            class="oe_highlight"/>

                    <button name="print_custom_pdf"
                            type="object"
                            string="report screen flower water "
                            class="oe_highlight"/>


                    <field name="water_record_ids">

                        <tree>
                            <!--                            <field name="sellected"/>-->
                            <field name="name_plant"/>
                            <field name="watering_date"/>
                            <field name="user_id"/>
                            <field name="note"/>
                        </tree>
                    </field>
                </page>
            </xpath>


        </field>
    </record>

    <record id="view_production_lot_tree_inherit" model="ir.ui.view">
        <field name="name">stock.production.lot.tree</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">


            <xpath expr="//field[@name='name']" position="after">
                <field name="name_plant"/>
            </xpath>


        </field>
    </record>
</odoo>
