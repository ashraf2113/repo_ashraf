        <field name="name">cancel in wizard</field>
        <field name="type">form</field>
        <field name="model">cancel.in.wizard</field>
        <field name="arch" type="xml">
            <form>
        <sheet>
        <group> 
            <field name="patients_id"/>
             <field name="reason" />
              <field name="time_cancel" />
           </group>
           <group>
 <footer>
<button string="cancel pations" name="action_cancel" type="object" class="btn-primary" data-hotkey="q"/>
